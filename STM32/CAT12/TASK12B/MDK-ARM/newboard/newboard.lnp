"newboard\stm32f4xx_it.o"
"newboard\stm32f4xx_hal_msp.o"
"newboard\stm32f4xx_hal_uart.o"
"newboard\stm32f4xx_hal_rcc.o"
"newboard\stm32f4xx_hal_rcc_ex.o"
"newboard\stm32f4xx_hal_flash.o"
"newboard\stm32f4xx_hal_flash_ex.o"
"newboard\stm32f4xx_hal_flash_ramfunc.o"
"newboard\stm32f4xx_hal_gpio.o"
"newboard\stm32f4xx_hal_dma_ex.o"
"newboard\stm32f4xx_hal_dma.o"
"newboard\stm32f4xx_hal_pwr.o"
